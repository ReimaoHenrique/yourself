{
  "name": "yourself-monorepo",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter desktop tauri dev",
    "dev:desktop": "pnpm --filter desktop tauri dev",
    "dev:mobile": "pnpm --filter mobile tauri android dev",
    "build": "pnpm --filter desktop build && pnpm --filter mobile build",
    "build:desktop": "pnpm --filter desktop build",
    "build:mobile": "pnpm --filter mobile build",
    "docker:up": "docker compose up --build -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  }
}
